#!/usr/bin/env bash
# ai-harness — 跨工具防膨胀 AI 辅助开发脚手架：初始化器 / 改造器 / 体检器
#
#   bash bin/ai-harness init     <dir> [--no-git] [--dry-run] [--force]
#   bash bin/ai-harness retrofit <dir> [--dry-run] [--no-git] [--skip-doctor]
#   bash bin/ai-harness upgrade  <dir> [--dry-run]
#   bash bin/ai-harness doctor   <dir>
#   bash bin/ai-harness install-skill [--host dsh|codex|claude] [--dest DIR]
#   bash bin/ai-harness version | help
#
# 设计原则：
#   1. 模板只存一份（./template），本脚本只做「复制 + 冲突隔离 + 栈探测」，不复制业务逻辑。
#   2. retrofit 不覆盖已有文件；upgrade 仅替换有安装基线且未改动的机制文件。
#   3. ignore 类文件用幂等 marker 块追加，重复执行不会产生第二份。
#   4. 只依赖 bash + 常见 Unix 工具（含 sha256sum 或 shasum），Windows 用 Git Bash 即可。
set -u

VERSION="1.1.0"

ROOT=$(cd "$(dirname "$0")/.." && pwd) || exit 1
TPL="$ROOT/template"
MARK_BEGIN="# >>> ai-harness managed block（勿手改，升级整体替换）>>>"
MARK_END="# <<< ai-harness managed block <<<"

DRY=0; NOGIT=0; FORCE=0; SKIP_DOCTOR=0
CONFLICTS=0; COPIED=0; SKIPPED=0; SUGGESTED=""
IGNORE_FILES=".gitignore .gitattributes .cursorignore .claudeignore"

say()  { printf '%s\n' "$*"; }
info() { printf '  %s\n' "$*"; }
warn() { printf '⚠️  %s\n' "$*" >&2; }
die()  { printf '❌ %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<EOF
ai-harness v$VERSION — 跨工具防膨胀 AI 辅助开发脚手架

用法:
  ai-harness init     <dir> [--no-git] [--dry-run] [--force]
      新项目：要求目标为空目录（或只有 .git）；复制全套脚手架。
  ai-harness retrofit <dir> [--no-git] [--skip-doctor] [--dry-run]
      老项目：不覆盖任何已有文件；探测技术栈生成 verify.conf；
      扫描代码树生成模块索引桩（标注待人工确认）。
  ai-harness upgrade  <dir> [--dry-run] [--accept-custom <relative-path>]
      已安装项目：自动更新未改过的机制文件并补缺；定制文件保留并生成冲突建议。
      人工合并一处定制文件后，可用 --accept-custom 记录本次模板基线。
  ai-harness doctor   <dir>
      体检：上下文体积、知识卡一致性、门禁自检、当前门状态、verify 配置。
  ai-harness install-skill [--host dsh|codex|claude] [--dest DIR]
      安装可发现的技能入口；默认 DSH，Codex/Claude 使用指向本仓库的薄入口。
  ai-harness version | help

退出码: 0 成功；1 参数/状态错误；doctor 发现问题时非 0。
EOF
}

need_dir() { [ -n "${1:-}" ] || die "缺少目标目录参数（见 ai-harness help）"; }
ensure_git_repo() { # <dir>; only initialize after Git explicitly reports no repository
  local tgt=$1 result current
  if result=$(LC_ALL=C git -C "$tgt" rev-parse --is-inside-work-tree 2>&1); then
    [ "$result" = true ] || die "目标不在普通 Git 工作区，拒绝初始化: $tgt"
    return 0
  fi
  case "$result" in
    *"not a git repository"*) ;;
    *) die "无法判定目标 Git 归属，拒绝初始化: $tgt ($result)" ;;
  esac
  current=$(cd "$tgt" && pwd -P) || die "无法解析目标目录: $tgt"
  while :; do
    [ ! -e "$current/.git" ] && [ ! -L "$current/.git" ] \
      || die "祖先目录存在 Git 标记但 Git 无法识别，拒绝初始化: $current"
    [ "$current" = / ] && break
    current=$(dirname "$current")
  done
  git -C "$tgt" init -b main >/dev/null || die "Git 初始化失败: $tgt"
  info "git 仓库已初始化（main）"
}

write_version() { # <dir> <mode>
  mkdir -p "$1/.ai-harness"
  printf 'version=%s\nmode=%s\ninstalled_at=%s\n' "$VERSION" "$2" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$1/.ai-harness/version"
}

# manifest 仅追踪分发机制。项目事实、红线和 ignore 文件不自动替换。
managed_file() { # <relative path>
  case "$1" in
    AGENTS.md|CLAUDE.md|.cursorrules|scripts/*.sh|.agents/skills/*.md|docs/specs/_templates/*.md|docs/task-pool/README.md|harness/CI.md|harness/verify.conf.example) return 0 ;;
    *) return 1 ;;
  esac
}

file_hash() { # <file>; stable across Git Bash and macOS
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d ' ' -f 1
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | cut -d ' ' -f 1
  else die "缺少 sha256sum/shasum，不能安全判断文件是否改动"; fi
}

safe_path() { # <target root> <relative path>; reject symlink and non-directory parents
  local root=$1 rel=$2 part current=$1 remaining=$2 IFS
  local -a parts
  [ ! -L "$root" ] || return 1
  IFS=/ read -r -a parts <<< "$rel"
  for part in "${parts[@]}"; do
    [ -n "$part" ] && [ "$part" != . ] && [ "$part" != .. ] || return 1
    current="$current/$part"
    [ ! -L "$current" ] || return 1
    case "$remaining" in
      */*) [ ! -e "$current" ] || [ -d "$current" ] || return 1; remaining=${remaining#*/} ;;
    esac
  done
}

write_manifest() { # <dir>; record only byte-identical managed files
  local tgt=$1 f rel tmp
  [ -d "$tgt/.ai-harness" ] || mkdir -p "$tgt/.ai-harness"
  safe_path "$tgt" .ai-harness/manifest.tsv || die "manifest 路径含符号链接"
  tmp=$(mktemp "$tgt/.ai-harness/.manifest.XXXXXX") || die "无法创建 manifest 临时文件"
  while IFS= read -r f; do
    rel=${f#"$TPL"/}
    managed_file "$rel" || continue
    if [ -f "$tgt/$rel" ] && [ ! -L "$tgt/$rel" ] && cmp -s "$f" "$tgt/$rel"; then
      printf '%s\t%s\t%s\n' "$(file_hash "$f")" "$(file_hash "$f")" "$rel" >> "$tmp"
    fi
  done < <(find "$TPL" -type f | sort)
  mv -f "$tmp" "$tgt/.ai-harness/manifest.tsv" || die "无法写入 manifest"
}

install_managed_file() { # <source> <destination> <relative path>; replace atomically
  local src=$1 dst=$2 rel=$3 tmp
  mkdir -p "$(dirname "$dst")" || die "无法创建升级目标目录: $rel"
  tmp=$(mktemp "$(dirname "$dst")/.ai-harness-upgrade.XXXXXX") || die "无法创建升级临时文件: $rel"
  cp -p "$src" "$tmp" || { rm -f "$tmp"; die "复制失败: $rel"; }
  case "$rel" in scripts/*.sh) chmod +x "$tmp" || { rm -f "$tmp"; die "设置执行权限失败: $rel"; } ;; esac
  mv -f "$tmp" "$dst" || { rm -f "$tmp"; die "安装失败: $rel"; }
}

# -------------------------------------------------------------------- 栈探测
detect_stack() { # <dir>
  local d=$1
  if   [ -f "$d/package.json" ]; then echo node
  elif [ -f "$d/pyproject.toml" ] || [ -f "$d/requirements.txt" ] || [ -f "$d/setup.py" ]; then echo python
  elif [ -f "$d/go.mod" ]; then echo go
  elif [ -f "$d/pom.xml" ] || [ -f "$d/build.gradle" ] || [ -f "$d/build.gradle.kts" ]; then echo java
  elif [ -f "$d/Cargo.toml" ]; then echo rust
  else echo generic; fi
}

# 初判源目录：优先 src/* 或语言惯用目录，否则顶层目录
source_dirs() { # <dir> <stack>
  local d=$1 stack=$2 cand=""
  case $stack in
    node)   [ -d "$d/src" ] && cand=$(find "$d/src" -mindepth 1 -maxdepth 1 -type d 2>/dev/null) ;;
    python) cand=$(find "$d" -mindepth 1 -maxdepth 1 -type d ! -name '.*' 2>/dev/null | while read -r p; do [ -f "$p/__init__.py" ] && echo "$p"; done); \
            [ -z "$cand" ] && [ -d "$d/src" ] && cand=$(find "$d/src" -mindepth 1 -maxdepth 1 -type d 2>/dev/null) ;;
    go)     for sub in internal pkg cmd app; do [ -d "$d/$sub" ] && cand="$cand$(find "$d/$sub" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
"; done ;;
    java)   [ -d "$d/src/main/java" ] && cand=$(find "$d/src/main/java" -mindepth 1 -maxdepth 1 -type d 2>/dev/null) ;;
    rust)   [ -d "$d/src" ] && cand=$(find "$d/src" -mindepth 1 -maxdepth 1 -type d 2>/dev/null) ;;
  esac
  if [ -z "$cand" ]; then
    cand=$(find "$d" -mindepth 1 -maxdepth 1 -type d ! -name '.*' 2>/dev/null | while read -r p; do
      b=$(basename "$p")
      case $b in node_modules|dist|build|coverage|out|target|vendor|reports|tests|test|docs|scripts|harness|public|assets|static|locale|locales|migrations) continue;; esac
      echo "$p"
    done)
  fi
  printf '%s\n' "$cand" | sed "s#^$d/##" | sed 's#/$##' | awk 'NF' | head -12
}

gen_verify_conf() { # <dir> <stack>
  local d=$1 stack=$2 cmd=""
  case $stack in
    node)
      if [ -f "$d/tsconfig.json" ]; then cmd='npx --no-install tsc --noEmit'
      elif [ -x "$d/node_modules/.bin/eslint" ]; then cmd='npx --no-install eslint "$TARGET_FILE" --max-warnings=0'
      elif [ -x "$d/node_modules/.bin/vitest" ]; then cmd='npx --no-install vitest related "$TARGET_FILE" --run'
      fi ;;
    python)
      if command -v ruff >/dev/null 2>&1; then cmd='ruff check "$TARGET_FILE"'
      elif command -v python >/dev/null 2>&1; then cmd='python -m py_compile "$TARGET_FILE"'
      elif command -v python3 >/dev/null 2>&1; then cmd='python3 -m py_compile "$TARGET_FILE"'
      fi ;;
    go)
      if [ -f "$d/go.mod" ]; then cmd='gofmt -l "$TARGET_FILE" | (! grep .)'; fi ;;
  esac
  [ -n "$cmd" ] || return 1
  {
    echo "# ai-harness retrofit 自动生成（$(date +%Y-%m-%d)）——请按团队实际工具链修正这一行"
    echo "# \$TARGET_FILE 由 scripts/ai-verify.sh 注入；没有真实检查时 ai-verify 会拒绝通过（设计如此）"
    printf 'CUSTOM_CHECK=%s\n' "'$cmd'"
  } > "$d/harness/verify.conf"
}

# ------------------------------------------------------------- 复制 + 冲突隔离
merge_ignore_file() { # <dir> <rel>
  local tgt=$1 rel=$2 src="$TPL/$2" dst="$1/$2"
  grep -qF "$MARK_BEGIN" "$dst" 2>/dev/null && { info "= $rel（已含 managed block，跳过）"; SKIPPED=$((SKIPPED+1)); return; }
  if [ "$DRY" -eq 0 ]; then
    { echo ""; echo "$MARK_BEGIN"; cat "$src"; echo "$MARK_END"; } >> "$dst"
    info "↳ 追加 managed block: $rel"
  else
    info "↳ [dry-run] 将追加 managed block: $rel"
  fi
}

copy_one() { # <dir> <rel>
  local tgt=$1 rel=$2 src="$TPL/$2" dst="$1/$2"
  if [ -e "$dst" ] || [ -L "$dst" ]; then
    if cmp -s "$src" "$dst" 2>/dev/null; then info "= $rel"; SKIPPED=$((SKIPPED+1)); return; fi
    if [ -f "$dst" ] && grep -q 'managed: retrofit' "$dst" 2>/dev/null; then info "= $rel（retrofit 已定制，保留）"; SKIPPED=$((SKIPPED+1)); return; fi
    local s="$tgt/.ai-harness/suggested/$rel"
    if [ "$DRY" -eq 0 ]; then mkdir -p "$(dirname "$s")"; cp "$src" "$s"; fi
    if [ "$DRY" -eq 1 ]; then info "→ [dry-run] 冲突，将建议合并: .ai-harness/suggested/$rel"
    else info "→ 冲突，已放建议文件: .ai-harness/suggested/$rel"; fi
    CONFLICTS=$((CONFLICTS+1)); SUGGESTED="$SUGGESTED$rel\n"; return
  fi
  if [ "$DRY" -eq 0 ]; then mkdir -p "$(dirname "$dst")"; cp "$src" "$dst"; fi
  info "+ $rel"; COPIED=$((COPIED+1))
}

copy_tree() { # <dir>
  local tgt=$1 rel f
  while IFS= read -r f; do
    rel=${f#"$TPL"/}
    case " $IGNORE_FILES " in
      *" $rel "*) merge_ignore_file "$tgt" "$rel"; continue ;;
    esac
    case "${SKIP_EXAMPLES:-0}:$rel" in
      1:docs/architecture/modules/example-*.md|1:docs/architecture/domain-map.md|1:docs/roadmap/ROADMAP.md|1:docs/roadmap/adr/001-template-adr.md) continue ;;
    esac
    copy_one "$tgt" "$rel"
  done < <(find "$TPL" -type f | sort)
  [ "$DRY" -eq 0 ] && chmod +x "$tgt"/scripts/*.sh 2>/dev/null || true
}

make_skeleton_dirs() { # <dir>
  [ "$DRY" -eq 0 ] || return 0
  mkdir -p "$1/docs/specs/active" "$1/docs/specs/archive" "$1/.ai-harness/suggested"
}

# ------------------------------------------------------ 模块候选（retrofit 只出清单）
gen_module_index() { # <dir> <stack> <index-new:0|1>
  local d=$1 stack=$2 index_new=$3 dirs rel n=0 out
  out="$d/.ai-harness/suggested/module-candidates.md"
  dirs=$(source_dirs "$d" "$stack")
  [ -n "$dirs" ] || { info "未扫到源码目录；请人工定位首个试点模块"; return 0; }
  say ""
  say "📦 扫描到的候选目录（仅供侦察，不自动认定模块边界）:"
  if [ "$DRY" -eq 0 ]; then
    mkdir -p "$(dirname "$out")"
    printf '# 模块候选（待核实）\n\n| 候选代码目录 | 实际模块边界与契约入口 |\n| :-- | :-- |\n' > "$out"
  fi
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    n=$((n+1))
    info "  $rel"
    [ "$DRY" -eq 1 ] || printf '| `%s/` | 待核实 |\n' "${rel#./}" >> "$out"
  done <<< "$dirs"
  if [ "$DRY" -eq 0 ] && [ "$index_new" -eq 1 ]; then
    sed -i '/docs\/architecture\/modules\/example-/d; /docs\/architecture\/domain-map.md/d' "$d/docs/architecture/00-INDEX.md"
  fi
  say "  共 $n 个候选；先选一个真实模块试点，再按 .agents/skills/retrofit-legacy.md 建活文档与索引。"
}

rewrite_allowed_dirs() { # <dir> <stack>
  local d=$1 stack=$2 dirs list=""
  dirs=$(source_dirs "$d" "$stack" | head -12)
  [ -n "$dirs" ] || return 0
  while IFS= read -r rel; do
    [ -n "$rel" ] && list="$list${rel}/,"
  done <<< "$dirs"
  [ -d "$d/tests" ] && list="${list}tests/,"
  list="${list}docs/specs/active/"
  mkdir -p "$d/.ai-harness/suggested/harness"
  printf 'ALLOWED_WRITE_DIRS="%s"\n' "$list" > "$d/.ai-harness/suggested/harness/allowed-write-dirs.txt"
  info "ALLOWED_WRITE_DIRS 候选已写入 .ai-harness/suggested/harness/allowed-write-dirs.txt；请审核后手动合并红线"
}

# ------------------------------------------------------------------ 命令实现
cmd_init() {
  local tgt="" a dry_label=""
  for a in "$@"; do case $a in --no-git) NOGIT=1;; --dry-run) DRY=1;; --force) FORCE=1;; -*) die "未知参数: $a";; *) tgt=$a;; esac; done
  need_dir "$tgt"; [ -d "$TPL" ] || die "模板缺失: $TPL"
  if [ -d "$tgt" ]; then
    local extra
    extra=$(find "$tgt" -mindepth 1 -maxdepth 1 ! -name '.git' 2>/dev/null | head -1)
    if [ -n "$extra" ] && [ "$FORCE" -eq 0 ]; then
      die "目标非空：$tgt（新项目请用空目录；改造既有项目请用 retrofit；确实要混装加 --force）"
    fi
  else
    [ "$DRY" -eq 0 ] && mkdir -p "$tgt"
  fi
  say "🚀 init → $tgt （template v$VERSION$dry_label）"
  copy_tree "$tgt"
  make_skeleton_dirs "$tgt"
  if [ "$DRY" -eq 0 ]; then
    write_version "$tgt" init
    write_manifest "$tgt"
    ( cd "$tgt" && bash scripts/ai-gate.sh status >/dev/null 2>&1 || true )   # 首次记录红线基线
    if [ "$NOGIT" -eq 0 ]; then ensure_git_repo "$tgt"; fi
  fi
  say ""
  say "✅ 完成：+$COPIED 个新文件，$SKIPPED 个同内容。"
  say "下一步（需要判断的部分，建议让 AI 按 skill 引导完成）:"
  say "  1. 改 docs/architecture/00-INDEX.md：把 example-* 换成你的真实模块"
  say "  2. 改 docs/architecture/modules/：每个模块写职责/契约/红线"
  say "  3. 配 harness/verify.conf：写一条真实增量检查命令（否则 ai-verify 会拒绝通过）"
  say "  4. 体检：bash scripts/harness-selftest.sh && bash scripts/ai-check-bloat.sh"
  say "  5. 试跑一条真实小需求：bash scripts/ai-new-spec.sh feat-hello"
}

cmd_retrofit() {
  local tgt="" a fresh=0
  for a in "$@"; do case $a in --dry-run) DRY=1;; --no-git) NOGIT=1;; --skip-doctor) SKIP_DOCTOR=1;; -*) die "未知参数: $a";; *) tgt=$a;; esac; done
  need_dir "$tgt"; [ -d "$tgt" ] || die "目标不存在: $tgt"; [ -d "$TPL" ] || die "模板缺失: $TPL"
  [ -e "$tgt/docs/architecture/00-INDEX.md" ] || fresh=1
  SKIP_EXAMPLES=1
  local stack; stack=$(detect_stack "$tgt")
  say "🔧 retrofit → $tgt"
  say "  技术栈探测: $stack"
  say ""
  copy_tree "$tgt"
  make_skeleton_dirs "$tgt"
  if [ "$DRY" -eq 0 ]; then
    [ -e "$tgt/.ai-harness/version" ] || write_version "$tgt" retrofit
    [ -e "$tgt/.ai-harness/manifest.tsv" ] || write_manifest "$tgt"
    if [ -f "$tgt/harness/verify.conf" ]; then
      info "harness/verify.conf 已存在，保留（不覆盖）"
    elif gen_verify_conf "$tgt" "$stack"; then
      info "已生成 harness/verify.conf（请核对命令）"
    else
      warn "未识别出可用的检查命令：请手写 harness/verify.conf，否则 ai-verify 会因 0 项检查失败（设计如此）"
    fi
    rewrite_allowed_dirs "$tgt" "$stack"
    gen_module_index "$tgt" "$stack" "$fresh"
    ( cd "$tgt" && bash scripts/ai-gate.sh status >/dev/null 2>&1 || true )
    if [ "$NOGIT" -eq 0 ]; then ensure_git_repo "$tgt"; fi
  else
    gen_module_index "$tgt" "$stack" "$fresh"
  fi
  say ""
  if [ "$CONFLICTS" -gt 0 ]; then
    if [ "$DRY" -eq 1 ]; then
      say "⚠️  预计有 $CONFLICTS 个冲突；正式执行时建议文件会放在 .ai-harness/suggested/："
    else
      say "⚠️  有 $CONFLICTS 个文件与已有内容冲突，未覆盖；建议文件在 .ai-harness/suggested/："
    fi
    printf '%b' "$SUGGESTED" | sed 's/^/     - /'
    say "   合并原则：只把模板里的「harness 机制」并进你的现有文件；过时/重复的旧文档移入 docs/specs/archive/，不要留两份。"
  fi
  if [ "$DRY" -eq 1 ]; then say "✅ 只读预演完成：预计新增 $COPIED 个文件，$SKIPPED 个同内容，$CONFLICTS 个冲突。"
  else say "✅ 完成：+$COPIED 个新文件，$SKIPPED 个同内容，$CONFLICTS 个冲突。"; fi
  if [ "$SKIP_DOCTOR" -eq 0 ] && [ "$DRY" -eq 0 ]; then doctor_core "$tgt"; fi
}

cmd_upgrade() {
  local tgt="" accept="" a f rel src dst current old_source old_local new suggestion manifest tmp mode installed seen=0
  while [ $# -gt 0 ]; do
    case $1 in
      --dry-run) DRY=1 ;;
      --accept-custom) shift; [ $# -gt 0 ] || die "--accept-custom 缺少路径"; accept=$1 ;;
      -*) die "未知参数: $1" ;;
      *) [ -z "$tgt" ] || die "只能指定一个目标目录"; tgt=$1 ;;
    esac
    shift
  done
  [ -z "$accept" ] || { safe_path "$TPL" "$accept" && managed_file "$accept" && [ -f "$TPL/$accept" ] || die "--accept-custom 只接受模板机制文件"; }
  [ "$DRY" -eq 0 ] || [ -z "$accept" ] || die "只读预演不能确认定制文件"
  need_dir "$tgt"
  [ -d "$tgt" ] && [ ! -L "$tgt" ] || die "目标不是普通目录: $tgt"
  [ -f "$tgt/.ai-harness/version" ] && [ ! -L "$tgt/.ai-harness/version" ] || die "目标未安装 ai-harness（缺少 .ai-harness/version）"
  [ -d "$TPL" ] || die "模板缺失: $TPL"
  safe_path "$tgt" .ai-harness/manifest.tsv && safe_path "$tgt" .ai-harness/version \
    && safe_path "$tgt" .ai-harness/suggested || die "升级元数据路径不安全"
  manifest="$tgt/.ai-harness/manifest.tsv"
  [ ! -e "$manifest" ] || [ -f "$manifest" ] || die "manifest 不是普通文件"
  command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1 || die "缺少 SHA-256 工具"
  # 全量路径预检先于任何写入，避免符号链接把内容导向项目外。
  while IFS= read -r f; do
    rel=${f#"$TPL"/}; managed_file "$rel" || continue
    safe_path "$tgt" "$rel" || die "升级路径不安全: $rel"
    new=$(file_hash "$f")
    safe_path "$tgt" ".ai-harness/suggested/$rel.upgrade-${new:0:12}" || die "建议文件路径不安全: $rel"
  done < <(find "$TPL" -type f | sort)
  if [ "$DRY" -eq 0 ]; then
    tmp=$(mktemp "$tgt/.ai-harness/.manifest.XXXXXX") || die "无法创建 manifest 临时文件"
  fi
  say "⬆️  upgrade → $tgt （template v$VERSION）"
  while IFS= read -r f; do
    rel=${f#"$TPL"/}; managed_file "$rel" || continue
    src=$f; dst="$tgt/$rel"; new=$(file_hash "$src"); old_source=""; old_local=""
    [ "$rel" != "$accept" ] || seen=1
    if [ -f "$manifest" ]; then
      old_source=$(awk -F '\t' -v name="$rel" '$3 == name {print $1; exit}' "$manifest")
      old_local=$(awk -F '\t' -v name="$rel" '$3 == name {print $2; exit}' "$manifest")
    fi
    case "$old_source:$old_local" in *[!0-9a-f:]* ) old_source=""; old_local="" ;; esac
    [ "${#old_source}" -eq 64 ] && [ "${#old_local}" -eq 64 ] || { old_source=""; old_local=""; }
    if [ ! -e "$dst" ]; then
      [ "$DRY" -eq 1 ] || install_managed_file "$src" "$dst" "$rel"
      info "+ $rel"; COPIED=$((COPIED+1))
      [ "$DRY" -eq 1 ] || printf '%s\t%s\t%s\n' "$new" "$new" "$rel" >> "$tmp"
    elif [ -f "$dst" ] && [ "$(file_hash "$dst")" = "$new" ]; then
      info "= $rel"; SKIPPED=$((SKIPPED+1))
      [ "$DRY" -eq 1 ] || printf '%s\t%s\t%s\n' "$new" "$new" "$rel" >> "$tmp"
    elif [ -f "$dst" ] && [ -n "$old_source" ] && [ "$old_source" = "$new" ] && [ "$(file_hash "$dst")" = "$old_local" ]; then
      info "= $rel（已确认定制）"; SKIPPED=$((SKIPPED+1))
      [ "$DRY" -eq 1 ] || printf '%s\t%s\t%s\n' "$new" "$old_local" "$rel" >> "$tmp"
    elif [ -f "$dst" ] && [ -n "$old_source" ] && [ "$old_source" = "$old_local" ] && [ "$(file_hash "$dst")" = "$old_local" ]; then
      [ "$DRY" -eq 1 ] || install_managed_file "$src" "$dst" "$rel"
      info "↑ $rel"; COPIED=$((COPIED+1))
      [ "$DRY" -eq 1 ] || printf '%s\t%s\t%s\n' "$new" "$new" "$rel" >> "$tmp"
    elif [ "$rel" = "$accept" ] && [ -f "$dst" ]; then
      current=$(file_hash "$dst")
      info "✓ $rel（已确认合并的定制文件）"; SKIPPED=$((SKIPPED+1))
      printf '%s\t%s\t%s\n' "$new" "$current" "$rel" >> "$tmp"
    else
      suggestion="$tgt/.ai-harness/suggested/$rel.upgrade-${new:0:12}"
      if [ "$DRY" -eq 0 ]; then
        mkdir -p "$(dirname "$suggestion")" || die "无法创建建议目录: $rel"
        if [ -e "$suggestion" ]; then
          cmp -s "$src" "$suggestion" || die "已有同名建议文件被改动，拒绝覆盖: $suggestion"
        else cp "$src" "$suggestion" || die "写入建议文件失败: $rel"; fi
        [ -z "$old_source" ] || printf '%s\t%s\t%s\n' "$old_source" "$old_local" "$rel" >> "$tmp"
      fi
      info "! $rel → .ai-harness/suggested/$rel.upgrade-${new:0:12}"
      CONFLICTS=$((CONFLICTS+1))
    fi
  done < <(find "$TPL" -type f | sort)
  [ -z "$accept" ] || [ "$seen" -eq 1 ] || die "未找到待确认的机制文件: $accept"
  if [ "$DRY" -eq 0 ]; then
    mv -f "$tmp" "$manifest" || die "无法更新 manifest"
    if [ "$CONFLICTS" -eq 0 ]; then
      mode=$(sed -n 's/^mode=//p' "$tgt/.ai-harness/version" | head -1)
      installed=$(sed -n 's/^installed_at=//p' "$tgt/.ai-harness/version" | head -1)
      [ -n "$mode" ] || mode=unknown
      [ -n "$installed" ] || installed=unknown
      tmp=$(mktemp "$tgt/.ai-harness/.version.XXXXXX") || die "无法创建版本临时文件"
      printf 'version=%s\nmode=%s\ninstalled_at=%s\nupgraded_at=%s\n' "$VERSION" "$mode" "$installed" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$tmp"
      mv -f "$tmp" "$tgt/.ai-harness/version" || die "无法更新版本"
    fi
  fi
  if [ "$DRY" -eq 1 ]; then say "只读预演：$COPIED 个待新增/更新，$SKIPPED 个已是新版，$CONFLICTS 个冲突。"
  else say "升级完成：$COPIED 个新增/更新，$SKIPPED 个已是新版，$CONFLICTS 个冲突。"; fi
  [ "$CONFLICTS" -eq 0 ] || { warn "冲突需合并；版本标记保留旧值，合并后重跑 upgrade。"; return 1; }
}

doctor_core() { # <dir>
  local tgt=$1 rc=0
  say ""
  say "🩺 doctor → $tgt"
  [ -f "$tgt/scripts/ai-gate.sh" ] || { warn "没有 scripts/ai-gate.sh，先 init/retrofit"; return 1; }
  ( cd "$tgt" && bash scripts/ai-check-bloat.sh ) || rc=1
  ( cd "$tgt" && bash scripts/ai-knowledge.sh check ) || rc=1
  ( cd "$tgt" && bash scripts/ai-gate.sh status | tail -3 ) || rc=1
  ( cd "$tgt" && bash scripts/harness-selftest.sh >/tmp/ai-harness-selftest.log 2>&1 ); local sr=$?
  if [ "$sr" -eq 0 ]; then info "🟢 门禁自检通过（$(grep '自检结果：' /tmp/ai-harness-selftest.log | tail -n 1)）"
  else warn "🔴 门禁自检失败，详见 /tmp/ai-harness-selftest.log 或直接跑 bash scripts/harness-selftest.sh"; rc=1; fi
  if [ -f "$tgt/harness/verify.conf" ]; then info "verify.conf: 已配置"; else warn "verify.conf: 未配置 → ai-verify 会拒绝通过（设计如此）"; fi
  [ "$rc" -eq 0 ] && say "🟢 doctor 通过" || say "🔴 doctor 有问题，先修再开工"
  return "$rc"
}

cmd_doctor() { need_dir "${1:-}"; [ -d "$1" ] || die "目标不存在: $1"; doctor_core "${1:-}"; }

cmd_install_skill() {
  local dest="" host="dsh"
  while [ $# -gt 0 ]; do
    case $1 in
      --dest) shift; [ $# -gt 0 ] || die "--dest 缺少目录"; dest="$1" ;;
      --dest=*) dest=${1#--dest=}; [ -n "$dest" ] || die "--dest 缺少目录" ;;
      --host) shift; [ $# -gt 0 ] || die "--host 缺少名称"; host="$1" ;;
      --host=*) host=${1#--host=} ;;
      -*) die "未知参数: $1" ;;
      *) dest=$1 ;;
    esac
    shift
  done
  case "$host" in
    dsh)    [ -n "$dest" ] || dest="${DSH_HOME:-$HOME/.dsh}/skills/ai-harness-scaffold" ;;
    codex)  [ -n "$dest" ] || dest="${CODEX_HOME:-$HOME/.codex}/skills/ai-harness-scaffold" ;;
    claude) [ -n "$dest" ] || dest="$HOME/.claude/skills/ai-harness-scaffold" ;;
    *) die "未知技能宿主: $host（可选 dsh / codex / claude）" ;;
  esac
  [ -f "$ROOT/skill/SKILL.md" ] || die "缺少 skill/SKILL.md"
  [ -L "$dest" ] && die "技能目录是符号链接，拒绝覆盖: $dest"
  if [ -e "$dest" ]; then
    [ -d "$dest" ] && [ -f "$dest/.ai-harness-skill" ] && [ ! -L "$dest/.ai-harness-skill" ] \
      || die "技能目录已有非本工具管理的内容，拒绝覆盖: $dest"
    grep -Fxq "host=$host" "$dest/.ai-harness-skill" \
      && grep -Fxq "source=$ROOT" "$dest/.ai-harness-skill" \
      || die "技能目录由其他宿主或来源管理，拒绝覆盖: $dest"
    [ -L "$dest/SKILL.md" ] && die "技能入口是符号链接，拒绝覆盖: $dest/SKILL.md"
    [ -e "$dest/SKILL.md" ] && [ ! -f "$dest/SKILL.md" ] \
      && die "技能入口不是普通文件，拒绝覆盖: $dest/SKILL.md"
    if [ "$host" = dsh ] && [ -n "$(find "$dest" -type l -print -quit)" ]; then
      die "DSH 技能目录含符号链接，拒绝覆盖: $dest"
    fi
  fi
  mkdir -p "$dest" || die "无法创建技能目录: $dest"
  if [ "$host" = dsh ]; then
    cp -R "$ROOT/skill/." "$dest/" || die "复制 DSH 技能正文失败: $dest"
    cp -R "$ROOT/bin" "$ROOT/template" "$dest/" || die "复制 DSH CLI 或模板失败: $dest"
    cp "$ROOT/README.md" "$dest/README.md" || die "复制 DSH README 失败: $dest"
    printf 'host=dsh\nsource=%s\n' "$ROOT" > "$dest/.ai-harness-skill" || die "写入技能归属记录失败: $dest"
    say "✅ 已安装 DSH skill: $dest"
    say "   skill 入口: $dest/SKILL.md；CLI: bash \"$dest/bin/ai-harness\" help"
    return 0
  fi
  local source_skill="$ROOT/skill/SKILL.md"
  if command -v cygpath >/dev/null 2>&1; then
    source_skill=$(cygpath -m "$source_skill") || die "无法转换共享技能路径"
  fi
  cat > "$dest/SKILL.md" <<EOF
---
name: ai-harness-scaffold
description: 给已有项目渐进接入 ai-harness 跨 IDE 开发脚手架，或初始化新项目。用户说“把这个老项目接入脚手架”时使用。
---

# ai-harness-scaffold 薄入口

共享技能唯一来源：$source_skill

先读取上述共享技能，并以其所在仓库为脚手架来源；再按该技能处理用户当前指定的目标项目。若源文件不存在，停止并告知用户重新安装。本入口不复制接入流程或项目状态。
EOF
  [ $? -eq 0 ] || die "写入 $host 技能入口失败: $dest/SKILL.md"
  printf 'host=%s\nsource=%s\n' "$host" "$ROOT" > "$dest/.ai-harness-skill" || die "写入技能归属记录失败: $dest"
  say "✅ 已安装 $host 薄技能入口: $dest"
  say "   共享流程: $source_skill"
}

case "${1:-help}" in
  init) shift; cmd_init "$@" ;;
  retrofit) shift; cmd_retrofit "$@" ;;
  upgrade) shift; cmd_upgrade "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  install-skill) shift; cmd_install_skill "$@" ;;
  version) say "ai-harness $VERSION (template @ $ROOT)" ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
